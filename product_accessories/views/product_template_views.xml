<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_accessories" model="ir.ui.view">
        <field name="name">product.template.form.product.accessories</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Accessories" name="product_accessories">
                    <field name="accessory_line_ids">
                        <list editable="bottom" default_order="sequence">
                            <field name="sequence" widget="handle"/>
                            <field name="accessory_product_id"/>
                            <field name="note"/>
                            <field name="required"/>
                            <field name="max_qty"/>
                            <field name="website_published"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
