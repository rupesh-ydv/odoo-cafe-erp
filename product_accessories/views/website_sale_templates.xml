<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Product Accessories
        Odoo 19 compatible website product page extension.
    -->
    <template
        id="product_accessories_section"
        inherit_id="website_sale.product"
        name="Product Accessories on Product Page"
    >

        <!--
            Insert after the main product information section.
            The standard Odoo 19 product template contains
            #product_details.
        -->
        <xpath expr="//div[@id='product_details']" position="inside">

            <t t-set="website_accessory_lines"
               t-value="product.accessory_line_ids.filtered(lambda l: l.active and l.website_published and l.accessory_product_id.active and l.accessory_product_id.sale_ok)"/>

            <section
                t-if="website_accessory_lines"
                id="product_accessories"
                class="product_accessories mt-4 mb-4"
            >

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <!-- Header -->
                        <div
                            class="d-flex justify-content-between align-items-center mb-3"
                        >
                            <div>
                                <h3 class="h5 mb-1">
                                    Add accessories
                                </h3>

                                <p class="text-muted small mb-0">
                                    Complete your order with these recommended products.
                                </p>
                            </div>

                            <span class="badge text-bg-light">
                                <t t-out="len(website_accessory_lines)"/>
                                available
                            </span>
                        </div>

                        <!-- Accessories -->
                        <div class="row g-3">

                            <t
                                t-foreach="website_accessory_lines"
                                t-as="accessory_line"
                            >

                                <div class="col-12 col-md-6">

                                    <label
                                        t-att-class="'product_accessory_card d-flex align-items-center gap-3 p-3 rounded border h-100 ' + ('is-required' if accessory_line.required else '')"
                                    >

                                        <!-- Checkbox -->
                                        <input
                                            class="form-check-input accessory-checkbox flex-shrink-0"
                                            type="checkbox"
                                            name="accessory_ids"
                                            t-att-value="accessory_line.accessory_product_id.id"
                                            t-att-checked="'checked' if accessory_line.required else None"
                                        />

                                        <!-- Product Image -->
                                        <div class="product_accessory_image">

                                            <img
                                                t-att-src="'/web/image/product.product/%s/image_128' % accessory_line.accessory_product_id.id"
                                                t-att-alt="accessory_line.accessory_product_id.display_name"
                                                loading="lazy"
                                                class="img-fluid rounded"
                                            />

                                        </div>

                                        <!-- Product Information -->
                                        <div class="flex-grow-1 min-width-0">

                                            <div class="fw-semibold text-truncate">
                                                <t
                                                    t-out="accessory_line.note or accessory_line.accessory_product_id.display_name"
                                                />
                                            </div>

                                            <div class="text-muted small">

                                                <span
                                                    t-field="accessory_line.accessory_product_id.lst_price"
                                                    t-options="{
                                                        'widget': 'monetary',
                                                        'display_currency': website.currency_id
                                                    }"
                                                />

                                                <t t-if="accessory_line.required">

                                                    <span class="badge text-bg-secondary ms-1">
                                                        Required
                                                    </span>

                                                </t>

                                            </div>

                                        </div>

                                    </label>

                                </div>

                            </t>

                        </div>

                        <!-- Action -->
                        <div
                            class="mt-3 d-flex flex-wrap gap-2 align-items-center"
                        >

                            <button
                                type="button"
                                id="add_to_cart_with_accessories"
                                class="btn btn-primary"
                            >

                                <i
                                    class="fa fa-shopping-cart me-1"
                                    aria-hidden="true"
                                />

                                Add to Cart with Accessories

                            </button>

                            <span class="small text-muted">
                                Selected accessories are added as separate order lines.
                            </span>

                        </div>

                    </div>

                </div>

            </section>

        </xpath>

    </template>

</odoo>